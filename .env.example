# Optional. After deploying worker/:
# VITE_API_BASE=https://thumbric-api.YOUR_SUBDOMAIN.workers.dev

# Custom domain (set in Pages workflow after thumbric.ai DNS is live):
# VITE_BASE_PATH=/
# VITE_SITE_URL=https://thumbric.ai/

# —— Premium AI (fal.ai Flux Schnell) ——
# Preferred: keep the key on the Worker, never in the client.
#   cd worker && npx wrangler secret put FAL_KEY
#   then build the site with VITE_API_BASE pointing at that Worker.
# VITE_API_BASE=https://thumbric-api.YOUR_SUBDOMAIN.workers.dev
#
# Local-only escape hatch (insecure — the key is baked into the JS bundle):
# VITE_FAL_KEY=your_fal_key_here
#
# Without either, the editor uses free Pollinations for 1 image, then fills
# 2 more looks locally (crop + color grade) so the picker always has 3 options.
